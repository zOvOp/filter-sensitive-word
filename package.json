{
  "name": "filter-sensitive-word",
  "version": "1.3.0",
  "description": "轻量级敏感词检测与过滤库",
  "keywords": [
    "sensitive",
    "sensitive-word",
    "filter",
    "word-filter",
    "text-filter",
    "censor",
    "profanity",
    "profanity-filter",
    "content-moderation",
    "dfa",
    "trie",
    "chinese",
    "敏感词",
    "敏感词过滤"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "author": "zOvOp <2537314409@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zOvOp/filter-sensitive-word.git"
  },
  "bugs": {
    "url": "https://github.com/zOvOp/filter-sensitive-word/issues"
  },
  "homepage": "https://zovop.github.io/filter-sensitive-word/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13"
  }
}
